apiVersion: v1
kind: Secret
metadata:
  name: solana-transactions-secrets
  namespace: solana-transactions
  labels:
    app.kubernetes.io/name: solana-transactions
    app.kubernetes.io/part-of: aiservice-solana-transactions
type: Opaque
stringData:
  # Database connection string (for in-cluster PostgreSQL service or Cloud SQL)
  DATABASE_URL: "postgres://postgres:postgres_secure_password_change_me@solana-transactions-db:5432/solana_transactions_db"
  # Optional: Private QuickNode / Helius / Alchemy Solana RPC endpoint
  # SOLANA_RPC_URL: "https://mainnet.helius-rpc.com/?api-key=YOUR_KEY"
